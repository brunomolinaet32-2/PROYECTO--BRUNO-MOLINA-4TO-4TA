#define ROJO 11
#define AZUL 10
#define VERDE 9

void setup()
{

  pinMode(11,OUTPUT);
 pinMode(10,OUTPUT);
 pinMode(9,OUTPUT);
}
void loop()
{
for( int r=0;r<=255;r+=12){
 delay(500);
 for( int b=0;b<=255;b+=12){
 delay(500);
  for(int g=0;g<=255;g+=12){
 analogWrite(ROJO,r);
 analogWrite(AZUL,b);
 analogWrite(VERDE,g);
}
}
}
  }
